# Base de datos (Neon).
# Usar el endpoint con sufijo -pooler (PgBouncer de Neon) y ?sslmode=require.
# El backend activa TLS (rejectUnauthorized:false) cuando ve sslmode=require
# o un host .neon.tech en esta cadena.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/letrados?sslmode=require

# Sesion
JWT_SECRETO=cambiar-por-una-cadena-larga-y-aleatoria
JWT_VENCIMIENTO=24h

# Correo. En desarrollo: consola. En produccion: el proveedor real.
# CORREO_API_KEY solo hace falta si CORREO_PROVEEDOR no es "consola".
CORREO_PROVEEDOR=consola
CORREO_API_KEY=

# URL publica del frontend, para armar el enlace de recuperacion
URL_FRONTEND=http://localhost:5173
